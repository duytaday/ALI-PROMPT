# Local development only. Configure separate values in every Vercel environment.
ALIPROMPT_ENVIRONMENT=development
POSTGRES_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Migration/backup tooling only. Use a direct or session-capable connection;
# do not expose this value to the Vercel runtime.
POSTGRES_MIGRATION_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
ALIPROMPT_DATABASE_ENVIRONMENT=development
BLOB_READ_WRITE_TOKEN=<development-blob-token>
ALIPROMPT_BLOB_ENVIRONMENT=development
# Development/Preview fixture only. It is deliberately rejected in Production.
ALIPROMPT_PAYMENT_PROVIDER=hmac_test
ALIPROMPT_PAYMENT_WEBHOOK_SECRET=<development-only-random-secret>
# Required in Preview and Production for the public prompt-submission anti-spam challenge.
SUBMISSION_CAPTCHA_SECRET=<long-random-secret>
# Required only when password recovery email is intentionally enabled.
ALIPROMPT_APP_URL=http://localhost:3000
ALIPROMPT_EMAIL_PROVIDER=resend
RESEND_API_KEY=<development-resend-key>
ALIPROMPT_EMAIL_FROM=ALIPROMPT <no-reply@example.test>
