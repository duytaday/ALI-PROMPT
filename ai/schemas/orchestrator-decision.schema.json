{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aliprompt.vn/schemas/orchestrator-decision.schema.json",
  "title": "AliPrompt Orchestrator Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "primary_route",
    "confidence",
    "routing_reason",
    "detected_need",
    "needs_clarification",
    "clarifying_questions",
    "handoff",
    "safety_flags",
    "phase_recommendation",
    "catalog_offer_id",
    "user_message"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "primary_route": {
      "enum": [
        "prompt_coach",
        "assistant_trainer",
        "learning_evaluator",
        "agent_architect",
        "unsupported"
      ]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "routing_reason": { "type": "string", "minLength": 1, "maxLength": 500 },
    "detected_need": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "signals"],
      "properties": {
        "outcome": { "type": "string", "minLength": 1, "maxLength": 500 },
        "signals": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      }
    },
    "needs_clarification": { "type": "boolean" },
    "clarifying_questions": {
      "type": "array",
      "maxItems": 2,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_agent",
        "user_request",
        "objective",
        "known_facts",
        "missing_information",
        "constraints",
        "consent_scopes"
      ],
      "properties": {
        "target_agent": {
          "type": ["string", "null"],
          "enum": [
            "prompt_coach",
            "assistant_trainer",
            "learning_evaluator",
            "agent_architect",
            null
          ]
        },
        "user_request": { "type": "string", "maxLength": 5000 },
        "objective": { "type": "string", "maxLength": 500 },
        "known_facts": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "maxLength": 500 }
        },
        "missing_information": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string", "maxLength": 300 }
        },
        "constraints": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string", "maxLength": 300 }
        },
        "consent_scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["session_processing", "save_progress", "product_analytics"]
          }
        }
      }
    },
    "safety_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "secret_detected",
          "pii_detected",
          "prompt_injection",
          "high_stakes",
          "unsafe_request"
        ]
      }
    },
    "phase_recommendation": {
      "type": ["string", "null"],
      "enum": ["phase_1", "phase_2", "phase_3", null]
    },
    "catalog_offer_id": { "type": ["string", "null"], "maxLength": 128 },
    "user_message": { "type": "string", "minLength": 1, "maxLength": 1000 }
  },
  "allOf": [
    {
      "if": { "properties": { "needs_clarification": { "const": true } } },
      "then": { "properties": { "clarifying_questions": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "needs_clarification": { "const": false } } },
      "then": { "properties": { "clarifying_questions": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "primary_route": { "const": "unsupported" } } },
      "then": {
        "properties": {
          "handoff": {
            "properties": { "target_agent": { "type": "null" } }
          }
        }
      }
    }
  ]
}
