{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aliprompt.vn/schemas/learning-checkpoint.schema.json",
  "title": "AliPrompt Learning Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checkpoint_id",
    "stage_id",
    "source_agent",
    "source_output_schema_version",
    "learning_objectives",
    "rubric",
    "initial_question",
    "mastery_policy",
    "source_summary"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "checkpoint_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "stage_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "source_agent": { "enum": ["prompt_coach", "assistant_trainer"] },
    "source_output_schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "learning_objectives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "contains": {
        "type": "object",
        "required": ["required"],
        "properties": { "required": { "const": true } }
      },
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "statement", "required", "evidence_types"],
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "statement": { "type": "string", "minLength": 1, "maxLength": 700 },
          "required": { "type": "boolean" },
          "evidence_types": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "enum": [
                "explanation",
                "comparison",
                "application",
                "correction",
                "prediction",
                "debug_trace"
              ]
            }
          }
        }
      }
    },
    "rubric": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "mastered_when", "not_mastered_when"],
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "mastered_when": { "type": "string", "minLength": 1, "maxLength": 900 },
          "not_mastered_when": { "type": "string", "minLength": 1, "maxLength": 900 }
        }
      }
    },
    "initial_question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "type", "prompt"],
      "properties": {
        "question_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "enum": ["open_ended", "scenario"] },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 1200 }
      }
    },
    "mastery_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_required_criteria_must_be_mastered",
        "self_assertion_is_not_evidence",
        "evaluator_is_authoritative"
      ],
      "properties": {
        "all_required_criteria_must_be_mastered": { "const": true },
        "self_assertion_is_not_evidence": { "const": true },
        "evaluator_is_authoritative": { "const": true }
      }
    },
    "source_summary": { "type": "string", "minLength": 1, "maxLength": 3000 }
  }
}
