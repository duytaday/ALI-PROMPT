{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aliprompt.vn/schemas/hook-event.schema.json",
  "title": "AliPrompt Hook Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_version",
    "event_id",
    "event_name",
    "request_id",
    "occurred_at",
    "actor",
    "payload",
    "metadata"
  ],
  "properties": {
    "event_version": { "const": "1.0.0" },
    "event_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "event_name": {
      "enum": [
        "request.received",
        "request.safety_reviewed",
        "route.selected",
        "agent.before_call",
        "agent.output_received",
        "agent.output_validated",
        "response.before_render",
        "response.rendered",
        "learning.answer_submitted",
        "learning.stage_evaluated",
        "phase.signal_emitted",
        "offer.before_render",
        "runtime.failed"
      ]
    },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["anonymous_user", "authenticated_user", "agent", "system"] },
        "id": { "type": ["string", "null"], "maxLength": 256 }
      }
    },
    "payload": {
      "type": "object",
      "description": "Payload theo event; phải là bản tối thiểu đã qua safety review."
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "agent_id", "prompt_version", "schema_version"],
      "properties": {
        "session_id": { "type": ["string", "null"], "maxLength": 128 },
        "agent_id": { "type": ["string", "null"], "maxLength": 128 },
        "prompt_version": { "type": ["string", "null"], "maxLength": 64 },
        "schema_version": { "type": ["string", "null"], "maxLength": 64 }
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["event_name"], "properties": { "event_name": { "const": "request.received" } } },
      "then": { "properties": { "payload": { "$ref": "hook-critical-payloads.schema.json#/$defs/requestReceived" } } }
    },
    {
      "if": { "required": ["event_name"], "properties": { "event_name": { "const": "request.safety_reviewed" } } },
      "then": { "properties": { "payload": { "$ref": "hook-critical-payloads.schema.json#/$defs/requestSafetyReviewed" } } }
    },
    {
      "if": { "required": ["event_name"], "properties": { "event_name": { "const": "route.selected" } } },
      "then": {
        "properties": {
          "payload": { "$ref": "hook-critical-payloads.schema.json#/$defs/routeSelected" },
          "metadata": { "type": "object", "properties": { "agent_id": { "const": "orchestrator" } } }
        }
      }
    },
    {
      "if": { "required": ["event_name"], "properties": { "event_name": { "const": "agent.before_call" } } },
      "then": {
        "properties": {
          "payload": { "$ref": "hook-critical-payloads.schema.json#/$defs/agentBeforeCall" },
          "metadata": { "type": "object", "properties": { "agent_id": { "type": "string", "minLength": 1 } } }
        }
      }
    },
    {
      "if": { "required": ["event_name"], "properties": { "event_name": { "const": "agent.output_received" } } },
      "then": {
        "properties": {
          "payload": { "$ref": "hook-critical-payloads.schema.json#/$defs/agentOutputReceived" },
          "metadata": { "type": "object", "properties": { "agent_id": { "type": "string", "minLength": 1 } } }
        }
      }
    },
    {
      "if": { "required": ["event_name"], "properties": { "event_name": { "const": "agent.output_validated" } } },
      "then": {
        "properties": {
          "payload": { "$ref": "hook-critical-payloads.schema.json#/$defs/agentOutputValidated" },
          "metadata": { "type": "object", "properties": { "agent_id": { "type": "string", "minLength": 1 } } }
        }
      }
    },
    {
      "if": { "required": ["event_name"], "properties": { "event_name": { "const": "learning.answer_submitted" } } },
      "then": { "properties": { "payload": { "$ref": "hook-critical-payloads.schema.json#/$defs/learningAnswerSubmitted" } } }
    },
    {
      "if": { "required": ["event_name"], "properties": { "event_name": { "const": "learning.stage_evaluated" } } },
      "then": {
        "properties": {
          "payload": { "$ref": "hook-critical-payloads.schema.json#/$defs/learningStageEvaluated" },
          "metadata": { "type": "object", "properties": { "agent_id": { "const": "learning_evaluator" } } }
        }
      }
    },
    {
      "if": { "required": ["event_name"], "properties": { "event_name": { "const": "response.before_render" } } },
      "then": {
        "properties": {
          "payload": { "$ref": "hook-critical-payloads.schema.json#/$defs/responseBeforeRender" },
          "metadata": { "type": "object", "properties": { "agent_id": { "type": "string", "minLength": 1 } } }
        }
      }
    },
    {
      "if": { "required": ["event_name"], "properties": { "event_name": { "const": "phase.signal_emitted" } } },
      "then": { "properties": { "payload": { "$ref": "hook-critical-payloads.schema.json#/$defs/phaseSignalEmitted" } } }
    },
    {
      "if": { "required": ["event_name"], "properties": { "event_name": { "const": "offer.before_render" } } },
      "then": { "properties": { "payload": { "$ref": "hook-critical-payloads.schema.json#/$defs/offerBeforeRender" } } }
    },
    {
      "if": { "required": ["event_name"], "properties": { "event_name": { "const": "response.rendered" } } },
      "then": { "properties": { "payload": { "$ref": "hook-critical-payloads.schema.json#/$defs/responseRendered" } } }
    },
    {
      "if": { "required": ["event_name"], "properties": { "event_name": { "const": "runtime.failed" } } },
      "then": { "properties": { "payload": { "$ref": "hook-critical-payloads.schema.json#/$defs/runtimeFailed" } } }
    },
    {
      "if": {
        "required": ["event_name", "metadata"],
        "properties": {
          "event_name": { "enum": ["agent.output_validated", "response.before_render"] },
          "metadata": { "type": "object", "required": ["agent_id"], "properties": { "agent_id": { "const": "orchestrator" } } }
        }
      },
      "then": { "properties": { "payload": { "type": "object", "properties": { "validated_output": { "$ref": "orchestrator-decision.schema.json" } } } } }
    },
    {
      "if": {
        "required": ["event_name", "metadata"],
        "properties": {
          "event_name": { "enum": ["agent.output_validated", "response.before_render"] },
          "metadata": { "type": "object", "required": ["agent_id"], "properties": { "agent_id": { "const": "prompt_coach" } } }
        }
      },
      "then": { "properties": { "payload": { "type": "object", "properties": { "validated_output": { "$ref": "prompt-coach-result.schema.json" } } } } }
    },
    {
      "if": {
        "required": ["event_name", "metadata"],
        "properties": {
          "event_name": { "enum": ["agent.output_validated", "response.before_render"] },
          "metadata": { "type": "object", "required": ["agent_id"], "properties": { "agent_id": { "const": "assistant_trainer" } } }
        }
      },
      "then": { "properties": { "payload": { "type": "object", "properties": { "validated_output": { "$ref": "assistant-training-plan.schema.json" } } } } }
    },
    {
      "if": {
        "required": ["event_name", "metadata"],
        "properties": {
          "event_name": { "enum": ["agent.output_validated", "response.before_render"] },
          "metadata": { "type": "object", "required": ["agent_id"], "properties": { "agent_id": { "const": "learning_evaluator" } } }
        }
      },
      "then": { "properties": { "payload": { "type": "object", "properties": { "validated_output": { "$ref": "learning-evaluation.schema.json" } } } } }
    },
    {
      "if": {
        "required": ["event_name", "metadata"],
        "properties": {
          "event_name": { "enum": ["agent.output_validated", "response.before_render"] },
          "metadata": { "type": "object", "required": ["agent_id"], "properties": { "agent_id": { "const": "agent_architect" } } }
        }
      },
      "then": { "properties": { "payload": { "type": "object", "properties": { "validated_output": { "$ref": "agent-architecture.schema.json" } } } } }
    }
  ]
}
