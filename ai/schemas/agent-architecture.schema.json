{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aliprompt.vn/schemas/agent-architecture.schema.json",
  "title": "AliPrompt Agent Architecture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "agent_id",
    "status",
    "readiness",
    "clarifying_questions",
    "outcome",
    "current_workflow",
    "proposed_workflow",
    "architecture_decision",
    "agents",
    "tools",
    "hooks",
    "threat_model",
    "acceptance_tests",
    "rollout",
    "boundaries",
    "phase_redirect",
    "refusal_reason"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "agent_id": { "const": "agent_architect" },
    "status": { "enum": ["ready", "needs_context", "refused"] },
    "readiness": {
      "enum": ["not_ready", "assisted_workflow", "bounded_agent", "multi_agent_candidate"]
    },
    "clarifying_questions": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "maxLength": 400 }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "metric", "success_threshold", "end_condition"],
      "properties": {
        "statement": { "type": "string", "maxLength": 700 },
        "metric": { "type": ["string", "null"], "maxLength": 300 },
        "success_threshold": { "type": ["string", "null"], "maxLength": 300 },
        "end_condition": { "type": ["string", "null"], "maxLength": 400 }
      }
    },
    "current_workflow": {
      "type": "array",
      "maxItems": 30,
      "items": { "$ref": "#/$defs/workflowStep" }
    },
    "proposed_workflow": {
      "type": "array",
      "maxItems": 30,
      "items": { "$ref": "#/$defs/workflowStep" }
    },
    "architecture_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "why_simplest", "tradeoffs", "rejected_alternatives"],
      "properties": {
        "summary": { "type": "string", "maxLength": 1200 },
        "why_simplest": { "type": "string", "maxLength": 800 },
        "tradeoffs": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string", "maxLength": 500 }
        },
        "rejected_alternatives": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["option", "reason"],
            "properties": {
              "option": { "type": "string", "maxLength": 300 },
              "reason": { "type": "string", "maxLength": 500 }
            }
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "purpose",
          "allowed_skills",
          "forbidden_actions",
          "input_contract",
          "output_contract",
          "handoff_to"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
          "purpose": { "type": "string", "maxLength": 600 },
          "allowed_skills": {
            "type": "array",
            "maxItems": 20,
            "items": { "type": "string", "maxLength": 128 }
          },
          "forbidden_actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": { "type": "string", "maxLength": 400 }
          },
          "input_contract": { "type": "string", "maxLength": 800 },
          "output_contract": { "type": "string", "maxLength": 800 },
          "handoff_to": {
            "type": "array",
            "maxItems": 10,
            "items": { "type": "string", "maxLength": 128 }
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "mode",
          "scope",
          "approval_required",
          "idempotency",
          "timeout",
          "rate_limit",
          "audit_fields"
        ],
        "properties": {
          "id": { "type": "string", "maxLength": 128 },
          "mode": { "enum": ["read", "write"] },
          "scope": { "type": "string", "maxLength": 500 },
          "approval_required": { "type": "boolean" },
          "idempotency": { "type": "string", "maxLength": 400 },
          "timeout": { "type": "string", "maxLength": 200 },
          "rate_limit": { "type": "string", "maxLength": 200 },
          "audit_fields": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "maxLength": 128 }
          }
        }
      }
    },
    "hooks": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event", "policy", "on_failure"],
        "properties": {
          "event": { "type": "string", "maxLength": 128 },
          "policy": { "type": "string", "maxLength": 600 },
          "on_failure": { "type": "string", "maxLength": 400 }
        }
      }
    },
    "threat_model": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["threat", "attack_path", "mitigation", "residual_risk"],
        "properties": {
          "threat": { "type": "string", "maxLength": 300 },
          "attack_path": { "type": "string", "maxLength": 600 },
          "mitigation": { "type": "string", "maxLength": 700 },
          "residual_risk": { "enum": ["low", "medium", "high"] }
        }
      }
    },
    "acceptance_tests": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scenario", "expected", "must_not"],
        "properties": {
          "id": { "type": "string", "maxLength": 128 },
          "scenario": { "type": "string", "maxLength": 800 },
          "expected": { "type": "string", "maxLength": 800 },
          "must_not": { "type": "string", "maxLength": 800 }
        }
      }
    },
    "rollout": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "scope", "metric", "stop_condition", "owner"],
        "properties": {
          "stage": { "enum": ["shadow", "draft_only", "limited_pilot", "gated_automation"] },
          "scope": { "type": "string", "maxLength": 500 },
          "metric": { "type": "string", "maxLength": 400 },
          "stop_condition": { "type": "string", "maxLength": 500 },
          "owner": { "type": ["string", "null"], "maxLength": 200 }
        }
      }
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "type": "string", "maxLength": 500 }
    },
    "phase_redirect": {
      "type": ["string", "null"],
      "enum": ["phase_1", "phase_2", null]
    },
    "refusal_reason": { "type": ["string", "null"], "maxLength": 700 }
  },
  "$defs": {
    "workflowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "owner", "kind", "input", "output", "failure_path"],
      "properties": {
        "step": { "type": "string", "maxLength": 400 },
        "owner": { "type": "string", "maxLength": 200 },
        "kind": { "enum": ["deterministic", "ai", "human"] },
        "input": { "type": "string", "maxLength": 500 },
        "output": { "type": "string", "maxLength": 500 },
        "failure_path": { "type": "string", "maxLength": 600 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "needs_context" } } },
      "then": { "properties": { "clarifying_questions": { "type": "array", "minItems": 1 } } }
    },
    {
      "if": { "properties": { "status": { "const": "refused" } } },
      "then": { "properties": { "refusal_reason": { "type": "string", "minLength": 1 } } }
    }
  ]
}
