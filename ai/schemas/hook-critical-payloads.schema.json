{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aliprompt.vn/schemas/hook-critical-payloads.schema.json",
  "title": "AliPrompt Critical Hook Payloads",
  "$defs": {
    "claimDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "verified_offer_ids",
        "removed_json_pointers",
        "unverified_claim_types"
      ],
      "properties": {
        "status": { "enum": ["verified", "sanitized", "no_commercial_claims"] },
        "verified_offer_ids": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "removed_json_pointers": { "type": "array", "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "pattern": "^/" } },
        "unverified_claim_types": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "enum": ["price", "schedule", "seats", "certification", "refund", "benefit"] }
        }
      },
      "allOf": [
        {
          "if": { "required": ["status"], "properties": { "status": { "const": "sanitized" } } },
          "then": {
            "properties": {
              "removed_json_pointers": { "type": "array", "minItems": 1 },
              "unverified_claim_types": { "type": "array", "minItems": 1 }
            }
          }
        },
        {
          "if": { "required": ["status"], "properties": { "status": { "const": "verified" } } },
          "then": { "properties": { "verified_offer_ids": { "type": "array", "minItems": 1 } } }
        }
      ]
    },
    "requestReceived": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consent", "user_message", "attachments"],
      "properties": {
        "consent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["session_processing"],
          "properties": {
            "session_processing": { "type": "boolean" },
            "save_progress": { "type": "boolean" },
            "product_analytics": { "type": "boolean" }
          }
        },
        "user_message": { "type": "string", "minLength": 1, "maxLength": 12000 },
        "attachments": { "type": "array", "maxItems": 10, "items": { "type": "object" } },
        "policy_decision": { "type": "object" },
        "normalized_content": { "type": "string", "minLength": 1, "maxLength": 30000 },
        "ingress_safety_request": { "$ref": "safety-review-request.schema.json" },
        "ingress_safety_review": { "$ref": "safety-review.schema.json" },
        "sanitized_content": { "type": "string", "minLength": 1, "maxLength": 30000 },
        "safety_flags": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "requestSafetyReviewed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safety_review"],
      "properties": { "safety_review": { "$ref": "safety-review.schema.json" } }
    },
    "agentBeforeCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_ids", "context_size", "attempt", "deadline"],
      "properties": {
        "skill_ids": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "context_size": { "type": "integer", "minimum": 0 },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 2 },
        "deadline": { "type": "string", "format": "date-time" },
        "policy_decision": { "type": "object" },
        "budget_decision": { "type": "object" }
      }
    },
    "agentOutputReceived": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_output"],
      "properties": {
        "raw_output": { "type": "string", "minLength": 1, "maxLength": 100000 },
        "validated_output": { "type": "object" },
        "validation_errors": { "type": "array", "maxItems": 30, "items": { "type": "object" } }
      }
    },
    "routeSelected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_decision", "sanitized_context"],
      "properties": {
        "route_decision": { "$ref": "orchestrator-decision.schema.json" },
        "sanitized_context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["locale", "user_level"],
          "properties": {
            "locale": { "type": "string", "minLength": 2, "maxLength": 20 },
            "user_level": { "enum": ["beginner", "intermediate", "advanced"] },
            "conversation_summary": { "type": ["string", "null"], "maxLength": 6000 },
            "owner_role": { "type": "string", "minLength": 1, "maxLength": 500 },
            "workflow": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "type": "object" } },
            "risk_tolerance": { "enum": ["low", "medium", "high", "unknown"] }
          }
        },
        "specialist_request": { "$ref": "specialist-request.schema.json" }
      }
    },
    "agentOutputValidated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validated_output"],
      "properties": {
        "validated_output": {
          "oneOf": [
            { "$ref": "orchestrator-decision.schema.json" },
            { "$ref": "prompt-coach-result.schema.json" },
            { "$ref": "assistant-training-plan.schema.json" },
            { "$ref": "learning-evaluation.schema.json" },
            { "$ref": "agent-architecture.schema.json" }
          ]
        },
        "learning_checkpoint": { "$ref": "learning-checkpoint.schema.json" },
        "available_offers": { "type": "array", "maxItems": 20, "items": { "type": "object" } },
        "claim_decision": { "$ref": "#/$defs/claimDecision" }
      }
    },
    "learningAnswerSubmitted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "learning_checkpoint",
        "answer_id",
        "answer_criterion_ids",
        "sanitized_answer",
        "prior_attempts",
        "user_level",
        "locale"
      ],
      "properties": {
        "learning_checkpoint": { "$ref": "learning-checkpoint.schema.json" },
        "answer_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "answer_criterion_ids": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "sanitized_answer": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "prior_attempts": { "type": "array", "maxItems": 20, "items": { "type": "object" } },
        "user_level": { "enum": ["beginner", "intermediate", "advanced"] },
        "locale": { "type": "string", "minLength": 2, "maxLength": 20 },
        "evaluator_request": { "$ref": "learning-evaluator-request.schema.json" }
      }
    },
    "learningStageEvaluated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation", "learning_checkpoint"],
      "properties": {
        "evaluation": { "$ref": "learning-evaluation.schema.json" },
        "learning_checkpoint": { "$ref": "learning-checkpoint.schema.json" },
        "stage_access": { "enum": ["locked", "unlocked"] }
      }
    },
    "phaseSignalEmitted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_agent", "signal", "observed_evidence"],
      "properties": {
        "source_agent": { "enum": ["prompt_coach", "assistant_trainer", "learning_evaluator", "agent_architect"] },
        "signal": { "enum": ["none", "assistant_training", "agent_architecture"] },
        "observed_evidence": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "phase_decision": { "type": "object" }
      }
    },
    "offerBeforeRender": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase_decision", "offer", "user_intent"],
      "properties": {
        "phase_decision": { "type": "object" },
        "offer": { "type": "object" },
        "user_intent": { "type": "string", "minLength": 1, "maxLength": 500 },
        "offer_render_decision": { "type": "object" }
      }
    },
    "responseBeforeRender": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validated_output", "claim_decision", "requested_actions", "outbound_provenance"],
      "properties": {
        "validated_output": {
          "oneOf": [
            { "$ref": "orchestrator-decision.schema.json" },
            { "$ref": "prompt-coach-result.schema.json" },
            { "$ref": "assistant-training-plan.schema.json" },
            { "$ref": "learning-evaluation.schema.json" },
            { "$ref": "agent-architecture.schema.json" }
          ]
        },
        "claim_decision": { "$ref": "#/$defs/claimDecision" },
        "public_output": { "type": "object" },
        "reviewed_public_output": { "type": "object" },
        "render_output": { "type": "object" },
        "requested_actions": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "outbound_provenance": { "$ref": "safety-review-request.schema.json#/properties/provenance" },
        "outbound_safety_review": { "$ref": "safety-review.schema.json" },
        "review_required": { "type": "boolean" },
        "allowed_actions": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } }
      }
    },
    "responseRendered": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "latency_ms", "validation_status", "safety_flag_types"],
      "properties": {
        "route": { "type": "string", "minLength": 1, "maxLength": 128 },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "validation_status": { "enum": ["valid", "repaired", "fallback"] },
        "safety_flag_types": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "telemetry_event": { "type": "object" }
      }
    },
    "runtimeFailed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error_code", "retryable"],
      "properties": {
        "error_code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "retryable": { "type": "boolean" },
        "public_error": { "type": "object" }
      }
    }
  }
}
